# Domain Monitor Configuration
# Copy this to .env or set as environment variables

# Domain to monitor
DOMAIN_URL=https://your-domain.com

# Check interval in minutes (default: 10)
CHECK_INTERVAL_MINUTES=10

# Request timeout in seconds
REQUEST_TIMEOUT=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=domain_monitor.log
SCHEDULER_LOG_FILE=scheduler.log

# Log Cleanup (automatic daily cleanup)
CLEANUP_DAYS=1
CLEANUP_TIME=00:00

# Zoho Cliq OAuth Credentials (optional - for alerts)
ZOHO_CLIQ_CLIENT_ID=your_client_id_here
ZOHO_CLIQ_CLIENT_SECRET=your_client_secret_here
ZOHO_CLIQ_REFRESH_TOKEN=your_refresh_token_here
ZOHO_CLIQ_CHANNEL_ID=your_channel_id_here

